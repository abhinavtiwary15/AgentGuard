# ==============================================================================
# AgentGuard - Environment Variables Specification
# Copy this file to .env and populate with your actual keys before running.
# REQUIRED fields have no default value and MUST be set.
# OPTIONAL fields have defaults shown — override as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
APP_NAME=AgentGuard                                # OPTIONAL
ENVIRONMENT=development                            # OPTIONAL (development | production)
DEBUG=False                                        # OPTIONAL
ALLOWED_ORIGINS=["http://localhost", "http://localhost:3000"]  # OPTIONAL

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-in-production  # REQUIRED
JWT_ALGORITHM=HS256                                # OPTIONAL
JWT_EXPIRE_MINUTES=60                              # OPTIONAL

# ------------------------------------------------------------------------------
# Azure OpenAI
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/  # REQUIRED
AZURE_OPENAI_KEY=your_openai_api_key_here                            # REQUIRED
AZURE_OPENAI_API_VERSION=2024-08-01-preview                          # OPTIONAL

# Deployment names (must match what you named them in Azure AI Foundry)
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o                   # OPTIONAL
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini               # OPTIONAL
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large  # OPTIONAL

# ------------------------------------------------------------------------------
# Azure AI Foundry
# ------------------------------------------------------------------------------
AZURE_FOUNDRY_ENDPOINT=https://your-foundry.api.azureml.ms  # OPTIONAL
AZURE_FOUNDRY_KEY=your_foundry_api_key_here                  # OPTIONAL
AZURE_FOUNDRY_PROJECT=agentguard                             # OPTIONAL

# ------------------------------------------------------------------------------
# Azure AI Search (RAG — MITRE ATT&CK + CVE + Threat Intel)
# ------------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://your-search-resource.search.windows.net  # REQUIRED
AZURE_SEARCH_KEY=your_search_admin_api_key_here                         # REQUIRED
AZURE_SEARCH_INDEX_THREATS=threat-intelligence  # OPTIONAL
AZURE_SEARCH_INDEX_CVE=cve-database             # OPTIONAL
AZURE_SEARCH_INDEX_MITRE=mitre-attack           # OPTIONAL

# ------------------------------------------------------------------------------
# Azure Cosmos DB (Incident & Report Persistence)
# Single connection string — find in Azure Portal > Cosmos DB > Keys
# ------------------------------------------------------------------------------
COSMOS_DB_CONNECTION=AccountEndpoint=https://your-cosmos.documents.azure.com:443/;AccountKey=your_key==;  # REQUIRED
COSMOS_DB_NAME=agentguard                  # OPTIONAL
COSMOS_CONTAINER_INCIDENTS=incidents       # OPTIONAL
COSMOS_CONTAINER_REPORTS=reports           # OPTIONAL
COSMOS_CONTAINER_AUDIT=audit_log           # OPTIONAL

# ------------------------------------------------------------------------------
# Azure Event Hub (Log Streaming Ingestion)
# ------------------------------------------------------------------------------
EVENT_HUB_CONNECTION=Endpoint=sb://your-eventhub.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your_key=  # REQUIRED
EVENT_HUB_NAME=security-logs  # OPTIONAL

# ------------------------------------------------------------------------------
# Azure Service Bus (Agent-to-Agent Messaging)
# ------------------------------------------------------------------------------
SERVICE_BUS_CONNECTION=Endpoint=sb://your-servicebus.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your_key=  # REQUIRED
SERVICE_BUS_QUEUE_THREATS=threat-signals    # OPTIONAL
SERVICE_BUS_QUEUE_RESPONSES=agent-responses # OPTIONAL

# ------------------------------------------------------------------------------
# Azure Communication Services (Email & SMS Alerts)
# ------------------------------------------------------------------------------
AZURE_COMMS_CONNECTION=endpoint=https://your-comms.communication.azure.com/;accesskey=your_key=  # REQUIRED
ALERT_EMAIL_FROM=alerts@agentguard.ai    # OPTIONAL
ALERT_EMAIL_TO=soc@yourcompany.com       # OPTIONAL
ALERT_SMS_FROM=+15551234567              # OPTIONAL (Azure ACS provisioned number)
ALERT_SMS_TO=+15559876543               # OPTIONAL (analyst on-call number)

# ------------------------------------------------------------------------------
# Microsoft Teams (SOC Channel Webhook)
# ------------------------------------------------------------------------------
TEAMS_WEBHOOK_URL=https://yourorg.webhook.office.com/webhookb2/your-webhook-id  # REQUIRED

# ------------------------------------------------------------------------------
# Power Automate HTTP Trigger Webhooks (Automated Response Actions)
# Create three separate instant-trigger flows in Power Automate
# ------------------------------------------------------------------------------
POWER_AUTOMATE_BLOCK_IP_URL=https://prod-XX.westus.logic.azure.com/workflows/your-id/triggers/manual/paths/invoke?api-version=2016-06-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=your-sig  # REQUIRED
POWER_AUTOMATE_REVOKE_SESSION_URL=https://prod-XX.westus.logic.azure.com/workflows/your-id/triggers/manual/paths/invoke?api-version=2016-06-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=your-sig  # REQUIRED
POWER_AUTOMATE_LOCK_ACCOUNT_URL=https://prod-XX.westus.logic.azure.com/workflows/your-id/triggers/manual/paths/invoke?api-version=2016-06-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=your-sig  # REQUIRED

# ------------------------------------------------------------------------------
# Azure Active Directory (Service Principal for API Graph calls)
# ------------------------------------------------------------------------------
AZURE_AD_TENANT_ID=your-tenant-id-guid          # REQUIRED
AZURE_AD_CLIENT_ID=your-app-registration-client-id  # REQUIRED
AZURE_AD_CLIENT_SECRET=your-client-secret-value     # REQUIRED

# ------------------------------------------------------------------------------
# Agent Behaviour Thresholds
# ------------------------------------------------------------------------------
THREAT_DETECTION_THRESHOLD=40       # OPTIONAL — min score (0-100) to flag a threat
AUTO_RESPONSE_THRESHOLD=70          # OPTIONAL — min score to auto-respond without human
HUMAN_ESCALATION_CONFIDENCE=0.70    # OPTIONAL — AI confidence below which human review is required
MONITORING_INTERVAL_SECONDS=5       # OPTIONAL — Event Hub polling interval
