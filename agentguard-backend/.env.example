# ==============================================================================
# AgentGuard - Environment Variables Specification
# Copy this file to .env before starting the backend.
#
# ZERO-COST LOCAL DEV: All Azure fields are OPTIONAL. If left unconfigured,
# AgentGuard automatically activates built-in local fallback modes (in-memory
# storage, mock RAG intelligence, and heuristic threat scoring).
#
# PRODUCTION: In production (ENVIRONMENT=production), JWT_SECRET MUST be set to
# a cryptographically strong secret, and real Azure cloud credentials should be supplied.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
APP_NAME=AgentGuard                                # OPTIONAL (default: AgentGuard)
ENVIRONMENT=development                            # OPTIONAL: "development" | "production" (default: development)
DEBUG=False                                        # OPTIONAL (default: False)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost"]  # OPTIONAL

# ------------------------------------------------------------------------------
# JWT Authentication & RBAC
# ------------------------------------------------------------------------------
# REQUIRED when ENVIRONMENT=production (minimum 32 characters)
# In development, a fallback dev key is used if omitted.
JWT_SECRET=dev-insecure-jwt-secret-agentguard-2026-minimum-32bytes
JWT_ALGORITHM=HS256                                # OPTIONAL (default: HS256)
JWT_EXPIRE_MINUTES=60                              # OPTIONAL (default: 60)

# ------------------------------------------------------------------------------
# Azure OpenAI (Optional — Fallback: Heuristic scoring and deterministic rules)
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=                             # OPTIONAL: e.g. https://<resource>.openai.azure.com/
AZURE_OPENAI_KEY=                                  # OPTIONAL: your Azure OpenAI API key
AZURE_OPENAI_API_VERSION=2024-12-01-preview        # OPTIONAL
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o               # OPTIONAL
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini           # OPTIONAL
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large  # OPTIONAL

# ------------------------------------------------------------------------------
# Azure AI Search (Optional — Fallback: Built-in local mock threat intel & MITRE)
# ------------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=                             # OPTIONAL: e.g. https://<search-service>.search.windows.net
AZURE_SEARCH_KEY=                                  # OPTIONAL: your Azure AI Search admin key
AZURE_SEARCH_INDEX_THREATS=threat-intelligence     # OPTIONAL
AZURE_SEARCH_INDEX_CVE=cve-database                # OPTIONAL
AZURE_SEARCH_INDEX_MITRE=mitre-attack              # OPTIONAL

# ------------------------------------------------------------------------------
# Azure Cosmos DB (Optional — Fallback: Ephemeral in-memory dictionary storage)
# ------------------------------------------------------------------------------
COSMOS_DB_CONNECTION=                              # OPTIONAL: AccountEndpoint=https://...;AccountKey=...;
COSMOS_DB_NAME=agentguard                          # OPTIONAL
COSMOS_CONTAINER_INCIDENTS=incidents               # OPTIONAL
COSMOS_CONTAINER_REPORTS=reports                   # OPTIONAL
COSMOS_CONTAINER_AUDIT=audit_log                   # OPTIONAL
COSMOS_CONTAINER_USERS=users                       # OPTIONAL

# ------------------------------------------------------------------------------
# Azure Event Hubs (Optional — Streaming SIEM Log Ingestion)
# ------------------------------------------------------------------------------
EVENT_HUB_CONNECTION=                              # OPTIONAL: Endpoint=sb://...;SharedAccessKey=...
EVENT_HUB_NAME=security-logs                       # OPTIONAL

# ------------------------------------------------------------------------------
# Azure Service Bus (Optional — External Agent Event Brokering)
# ------------------------------------------------------------------------------
SERVICE_BUS_CONNECTION=                            # OPTIONAL: Endpoint=sb://...;SharedAccessKey=...
SERVICE_BUS_QUEUE_THREATS=threat-signals           # OPTIONAL
SERVICE_BUS_QUEUE_RESPONSES=agent-responses        # OPTIONAL

# ------------------------------------------------------------------------------
# Microsoft Teams (Optional — Channel Webhook Notifications)
# ------------------------------------------------------------------------------
TEAMS_WEBHOOK_URL=                                 # OPTIONAL: Incoming webhook URL

# ------------------------------------------------------------------------------
# Power Automate (Optional — Containment Automation Workflows)
# ------------------------------------------------------------------------------
POWER_AUTOMATE_BLOCK_IP_URL=                       # OPTIONAL: Flow HTTP trigger URL
POWER_AUTOMATE_REVOKE_SESSION_URL=                 # OPTIONAL: Flow HTTP trigger URL
POWER_AUTOMATE_LOCK_ACCOUNT_URL=                   # OPTIONAL: Flow HTTP trigger URL

# ------------------------------------------------------------------------------
# Agent Thresholds & Tuning
# ------------------------------------------------------------------------------
THREAT_DETECTION_THRESHOLD=40                      # OPTIONAL: Minimum score to flag a threat (0-100)
AUTO_RESPONSE_THRESHOLD=70                         # OPTIONAL: Score to authorize autonomous action
HUMAN_ESCALATION_CONFIDENCE=0.70                   # OPTIONAL: Confidence below which human review is requested
MONITORING_INTERVAL_SECONDS=5                      # OPTIONAL
